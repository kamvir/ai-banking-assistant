# Copy to apps/api/.env and fill in real values. Never commit .env.

# OpenAI
OPENAI_API_KEY=

# Pinecone
PINECONE_API_KEY=
PINECONE_INDEX_NAME=ai-banking-assistant
# Only used by `npm run ingest` if the index doesn't exist yet and needs creating.
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# RAG
# Minimum top-match similarity score (0-1) before answering from retrieved context;
# below this, the chat escalates to a human agent instead of guessing. Tune after ingesting.
RAG_CONFIDENCE_THRESHOLD=0.75

# API server
PORT=3000
CORS_ORIGIN=http://localhost:8100
